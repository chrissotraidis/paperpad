+// The real flash chip decodes only the address lines that cover its 128 KiB,
+// so page numbers outside the chip wrap around. Paper Mario relies on this
+// when it reads an empty save slot: fio passes page_num = -1, which libultra
+// multiplies by 128 into a huge byte offset. Masking keeps the backing-save
+// access in bounds; the wrapped region is erased (0xFF) flash, so the game's
+// checksum validation fails gracefully instead of crashing the host.
+static uint32_t flash_page_offset(uint32_t page_num) {
+    return (page_num & (page_count - 1)) * page_size;
+}
+
 // Staging area for a single page program: osFlashWriteBuffer fills it,
 // osFlashWriteArray commits it to the backing save at the chosen page.
 std::array<char, page_size> write_buffer;
