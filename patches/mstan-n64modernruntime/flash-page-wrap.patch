     uint32_t page_num = (uint32_t)ctx->r4;
 
-    // Reject an out-of-range page rather than clearing past the save.
-    if (page_num >= page_count) {
-        ctx->r2 = -1;
-        return;
-    }
-
-    save_clear(page_num * page_size, page_size, 0xFF);
+    // Mask like the chip's address decode; an out-of-range page erases the
+    // wrapped (already erased) region, so the status stays success.
+    save_clear(flash_page_offset(page_num), page_size, 0xFF);
     ctx->r2 = 0;
 }
 
