+#if defined(N64MODERN_NO_DYNAMIC_CODE)
+    (void)func_index;
+    return GenericFunction{ static_cast<recomp_func_t*>(nullptr) };
+#else
     return GenericFunction{ recompiler_output->functions[func_index] };
+#endif
